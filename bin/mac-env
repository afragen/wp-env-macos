#!/bin/sh
# wp-env-opossum — a wp-env replacement backed by Apple `container` via opossum.
#
# Drives the compose.yaml stack (no Podman/Docker Desktop VM) and provisions a
# runnable WordPress instance — the `npm run env:install` equivalent: wp core
# install (dev + tests), wp-config constants, plugin/theme activation, and
# wp-tests-config.php generation. This mirrors @wordpress/env's configureWordPress
# step, translated from `docker compose` to `opossum exec`.
#
# Usage: see `mac-env help` (or `mac-env --help`).
#
# Requires macOS 26+ / Apple silicon, `container` running, and opossum installed.
# Database reachability uses container-name DNS: mac-env runs
# `sudo container system dns create opossum` ONCE (idempotent) on first `up`,
# after which app containers reach the DB by bare service name (mysql /
# tests-mysql) — no host LAN IP or published DB ports needed.

# Configuration (all optional; sensible defaults apply):
#   WP_PLUGIN_SLUG        plugin directory name under wp-content/plugins
#                         (default: current directory basename)
#   WP_ENV_CACHE_DIR      path to @wordpress/env's cache (populated by `wp-env
#                         start` once, or by `mac-env install-wp-tests`)
#   WP_ENV_PORT / WP_ENV_TESTS_PORT
#   HOST_USERNAME / HOST_UID / HOST_GID   (auto-detected from `id` if unset)
#   WP_ENV_FIXTURE_PLUGINS / WP_ENV_FIXTURE_THEMES
#                         space-separated host paths mounted into the containers
#                         as fixture plugins/themes (e.g. tests/fixtures/.../*)
#   WP_ENV_DEV_THEME      theme activated on the dev site (default twentytwentyfour)
#   XDEBUG_HOST           IP/host xdebug connects back to (default host.docker.internal)

set -e

# --- Locate the package root (where templates/ and docker/ live) ---
# When installed via npm, the bin is symlinked into node_modules/.bin, so $0
# points at the symlink. Resolve it to the real file first.
if [ -L "$0" ]; then
	SCRIPT_DIR="$(cd "$(dirname "$(readlink "$0")")" && pwd)"
else
	SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fi
PKG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
[ -d "$PKG_ROOT/templates" ] || PKG_ROOT="$SCRIPT_DIR"

# --- Host environment (auto-detected; explicit values win) ---
export HOST_USERNAME="${HOST_USERNAME:-$(id -un)}"
export HOST_UID="${HOST_UID:-$(id -u)}"
export HOST_GID="${HOST_GID:-$(id -g)}"
export XDEBUG_HOST="${XDEBUG_HOST:-host.docker.internal}"

OPOSSUM="${OPOSSUM:-opossum}"
COMPOSE="${COMPOSE:-compose.yaml}"

# Project context.
PROJECT_NAME="$(basename "$PWD")"
WP_PLUGIN_SLUG="${WP_PLUGIN_SLUG:-$PROJECT_NAME}"
DEV_PORT="${WP_ENV_PORT:-8888}"
TESTS_PORT="${WP_ENV_TESTS_PORT:-8889}"
DEV_THEME="${WP_ENV_DEV_THEME:-twentytwentyfour}"

# One-time DNS setup so bare service names (mysql, tests-mysql) resolve across
# the opossum-managed containers. Idempotent: only run sudo when the
# `opossum` DNS domain isn't already registered (checked via `dns list`).
ensure_dns() {
	if ! container system dns list 2>/dev/null | grep -qx opossum; then
		echo "mac-env: setting up container DNS (one-time, requires sudo)…"
		sudo container system dns create opossum || true
	fi
}

# List all wp-env cache subdirs (one per project), newline-separated.
list_cache_dirs() {
	local cache_root="$HOME/.wp-env"
	[ -d "$cache_root" ] || return 0
	find "$cache_root" -maxdepth 1 -type d ! -name "$(basename "$cache_root")" 2>/dev/null || true
}

# Detect the wp-env cache dir: if ~/.wp-env has exactly one subdirectory,
# use it; otherwise emit nothing (caller leaves WP_ENV_CACHE_DIR blank).
detect_cache_dir() {
	local dirs count
	dirs="$(list_cache_dirs)"
	count="$(printf '%s\n' $dirs | grep -c . || true)"
	[ "$count" = "1" ] && printf '%s' "$dirs"
}

# --- `init`: scaffold compose.yaml + .env into the current project ---
do_init() {
	# If compose.yaml already exists, re-init is allowed — automatically force
	# the overwrite (equivalent to running with WP_ENV_FORCE_INIT=1) instead of
	# refusing.
	if [ -f compose.yaml ]; then
		[ -n "$WP_ENV_FORCE_INIT" ] || echo "mac-env: compose.yaml already exists — re-initializing (overwrite forced)." >&2
		WP_ENV_FORCE_INIT=1
	fi
	# Determine the plugin slug: it's the project directory name, since the
	# project root is mounted at wp-content/plugins/<slug>. (.wp-env.json may
	# list "." or a path; we don't derive the slug from it to stay robust.)
	local slug="$PROJECT_NAME"
	WP_PLUGIN_SLUG="$slug"

	# Discover fixture plugins/themes under common test paths.
	local fx_plugins="" fx_themes=""
	if [ -d tests/fixtures/plugins ]; then
		for d in tests/fixtures/plugins/*/; do
			[ -d "$d" ] && fx_plugins="$fx_plugins${fx_plugins:+ }${d%/}"
		done
	fi
	if [ -d tests/fixtures/themes ]; then
		for d in tests/fixtures/themes/*/; do
			[ -d "$d" ] && fx_themes="$fx_themes${fx_themes:+ }${d%/}"
		done
	fi
	WP_ENV_FIXTURE_PLUGINS="${WP_ENV_FIXTURE_PLUGINS:-$fx_plugins}"
	WP_ENV_FIXTURE_THEMES="${WP_ENV_FIXTURE_THEMES:-$fx_themes}"

	# Render the template compose file.
	render_compose > compose.yaml
	# Copy the docker/ build context into the project so builds resolve locally.
	mkdir -p docker
	cp -R "$PKG_ROOT/docker/." docker/ 2>/dev/null || true

	# Add wp-env-opossum scripts to package.json (idempotent).
	sync_package_scripts
	# Write/extend .env. If it already exists (e.g. from another tool), append
	# the wp-env-opossum keys rather than overwriting — but only once, guarded
	# by a marker comment so re-running init is idempotent.
	if [ ! -f .env ]; then
		render_env > .env
	elif ! grep -q '# wp-env-opossum' .env 2>/dev/null; then
		{
			echo ''
			echo '# wp-env-opossum'
			render_env_body
		} >> .env
	fi

	# Append wp-env-opossum ignores if not already present (idempotent per
	# entry, so re-running init after a partial block still completes it).
	for entry in '.env' '.opossum-home/' 'docker/' 'compose.yaml'; do
		grep -qxF "$entry" .gitignore 2>/dev/null || printf '%s\n' "$entry" >> .gitignore
	done

	echo "mac-env: initialized in $(pwd)"
	echo "  plugin slug : $WP_PLUGIN_SLUG"
	echo "  fixtures    : ${WP_ENV_FIXTURE_PLUGINS:-none} ${WP_ENV_FIXTURE_THEMES:+| $WP_ENV_FIXTURE_THEMES}"
	[ -f package.json ] && echo "  scripts     : added env:start/env:stop/env:install/test[/:multisite/:coverage/:php80] to package.json"
	# Surface the wp-env cache dir so the user can paste it into .env.
	cache_dir="$(detect_cache_dir || true)"
	if [ -n "$cache_dir" ]; then
		echo "  cache dir   : $cache_dir"
		echo "    → copy into .env:  WP_ENV_CACHE_DIR=$cache_dir"
	elif [ -d "$HOME/.wp-env" ]; then
		echo "  cache dir   : (multiple found under ~/.wp-env — any complete one works)"
		echo "    → run:  mac-env cache-list"
		echo "      pick a dir with WordPress/, tests-WordPress/, *-PHPUnit/ subdirs"
		echo "    → copy that into .env as:  WP_ENV_CACHE_DIR=<path>"
	else
		echo "  cache dir   : (not found — ~/.wp-env missing)"
		echo "    → run 'mac-env install-wp-tests' (or 'wp-env start' once) to populate it, then re-run 'mac-env init'"
	fi
	echo "  next steps  : set WP_ENV_CACHE_DIR in .env, then 'mac-env up'"
}

# Add wp-env-opossum scripts to package.json if it exists, idempotently.
# Uses `npm pkg set` so existing scripts are preserved and JSON stays valid.
sync_package_scripts() {
	[ -f package.json ] || return 0
	npm pkg set scripts.env:start="wp-env-opossum up" >/dev/null 2>&1 || true
	npm pkg set scripts.env:stop="wp-env-opossum down" >/dev/null 2>&1 || true
	npm pkg set scripts.env:install="wp-env-opossum provision" >/dev/null 2>&1 || true
	npm pkg set scripts.test="wp-env-opossum test" >/dev/null 2>&1 || true
	npm pkg set scripts.test:multisite="wp-env-opossum test:multisite" >/dev/null 2>&1 || true
	npm pkg set scripts.test:coverage="wp-env-opossum test:coverage" >/dev/null 2>&1 || true
	npm pkg set scripts.test:php80="wp-env-opossum test:php80" >/dev/null 2>&1 || true
}

render_compose() {
	# Render the template: replace placeholders with project-specific values.
	python3 - "$WP_PLUGIN_SLUG" "$WP_ENV_FIXTURE_PLUGINS" "$WP_ENV_FIXTURE_THEMES" "$DEV_THEME" "$PKG_ROOT/templates/compose.yaml.tpl" <<'PY'
import sys, os
slug, fx_plugins, fx_themes, dev_theme, tpl = sys.argv[1:6]
pwd = os.getcwd()
def mount_lines(paths):
    out=[]
    for p in paths.split():
        out.append(f"      - '{pwd}/{p}:/var/www/html/wp-content/plugins/{p.split('/')[-1]}'")
    return "\n".join(out)
def theme_lines(paths):
    out=[]
    for p in paths.split():
        out.append(f"      - '{pwd}/{p}:/var/www/html/wp-content/themes/{p.split('/')[-1]}'")
    return "\n".join(out)
s=open(tpl, encoding='utf-8').read()
s=s.replace('@@PLUGIN_SLUG@@', slug)
s=s.replace('@@DEV_THEME@@', dev_theme)
s=s.replace('@@FIXTURE_PLUGIN_MOUNTS@@', mount_lines(fx_plugins) or "# (no fixture plugins)")
s=s.replace('@@FIXTURE_THEME_MOUNTS@@', theme_lines(fx_themes) or "# (no fixture themes)")
sys.stdout.write(s)
PY
}

render_env_body() {
	cat <<EOF
# Path to @wordpress/env's cache (populated by 'wp-env start' once, or by
# 'mac-env install-wp-tests'). Found via:
#   mac-env cache-list   (auto-detected below if exactly one exists)
WP_ENV_CACHE_DIR=${WP_ENV_CACHE_DIR:-$(detect_cache_dir)}

# Host user identity is auto-detected by mac-env from 'id' — usually no need to set.
# HOST_USERNAME=
# HOST_UID=
# HOST_GID=

# Published ports (defaults match @wordpress/env: 8888 dev, 8889 tests).
# The database is reached by container-name DNS (mysql / tests-mysql), so no
# DB ports are published.
WP_ENV_PORT=8888
WP_ENV_TESTS_PORT=8889

# Plugin directory name under wp-content/plugins (default: project dir name).
# WP_PLUGIN_SLUG=$PROJECT_NAME

# Theme activated on the dev site so it renders a real page (not a fixture stub).
WP_ENV_DEV_THEME=twentytwentyfour
EOF
}

render_env() {
	echo "# wp-env-opossum environment — generated by 'mac-env init'."
	echo ''
	render_env_body
}

# --- Animated progress spinner (TTY only) ---
# Usage:  start_spinner "cloning WordPress core…"
#         …slow work…
#         stop_spinner
# The spinner only animates when stdout is a terminal (skipped for pipes/CI).
# Braille frames are multibyte UTF-8, so we index them as positional params
# (set -- …) and pull each with `eval "g=\${$n}"` — portable, no byte math.
_SPINNER_PID=""
_SPINNER_LABEL=""
start_spinner() {
	_SPINNER_LABEL="$1"
	[ -t 1 ] || return 0
	printf '%s' "$_SPINNER_LABEL"
	( set +x
	  set -- '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏'
	  local i=0 g
	  trap 'exit 0' TERM
	  while true; do
		eval "g=\${$((i % 10 + 1))}"
		printf '\r%s %s' "$g" "$_SPINNER_LABEL"
		i=$((i + 1))
		sleep 0.1
	  done
	) &
	_SPINNER_PID=$!
}
stop_spinner() {
	[ -n "$_SPINNER_PID" ] && kill "$_SPINNER_PID" 2>/dev/null && wait "$_SPINNER_PID" 2>/dev/null
	_SPINNER_PID=""
	[ -t 1 ] && printf '\r\033[K'
	# Always succeed: the final `[ -t 1 ]` is false in non-TTY and would
	# otherwise make `set -e` abort the caller.
	return 0
}

# --- Variant 2: git-based WordPress core + PHPUnit test-lib fetch ---

# Resolve a wp-version argument into a git ref.
#   X.Y.Z       -> tag "X.Y.Z"
#   trunk        -> branch "trunk"
#   latest|""   -> query api.wordpress.org for the latest stable tag
resolve_wp_version() {
	local v="${1:-latest}"
	if [ "$v" = "trunk" ]; then
		printf 'trunk'
		return
	fi
	if [ "$v" = "latest" ] || [ -z "$v" ]; then
		local json
		json="$(curl -s http://api.wordpress.org/core/version-check/1.7/ 2>/dev/null || true)"
		v="$(printf '%s' "$json" | grep -o '"version":"[^"]*' | sed 's/"version":"//' | head -1)"
		[ -n "$v" ] || { echo "mac-env: latest WordPress version could not be found" >&2; return 1; }
	fi
	printf '%s' "$v"
}

# Shared sync: clone-or-pull the two source repos into <cache>/.src-* and
# arrange them into the four consumed subdirs, then rewrite wp-tests-config.php.
# Idempotent: re-running with the same tag is a fetch + rsync (deltas only).
sync_wp_env_cache() {
	cache_dir="$1"
	tag="$2"
	src_wp="$cache_dir/.src-wordpress"
	src_dev="$cache_dir/.src-develop"

	# --- WordPress/WordPress (release core) -> WordPress/ + tests-WordPress/ ---
	start_spinner "cloning WordPress core ($tag)…"
	if [ -d "$src_wp/.git" ]; then
		# Skip the network fetch + rsync when the clone already sits at $tag
		# (e.g. a re-pull of an unchanged pinned version) — makes re-runs fast.
		local at_wp="$tag"
		[ "$tag" != "trunk" ] && at_wp="$(git -C "$src_wp" rev-parse "$tag" 2>/dev/null || true)"
		local cur_wp="$(git -C "$src_wp" rev-parse HEAD 2>/dev/null || true)"
		if [ -n "$at_wp" ] && [ "$at_wp" = "$cur_wp" ]; then
			git -C "$src_wp" checkout -q "$tag" >/dev/null 2>&1 || true
		elif [ "$tag" = "trunk" ]; then
			git -C "$src_wp" fetch --tags >/dev/null 2>&1 || true
			git -C "$src_wp" pull --ff-only >/dev/null 2>&1 || true
		else
			git -C "$src_wp" fetch --tags >/dev/null 2>&1 || true
			git -C "$src_wp" checkout "$tag" >/dev/null 2>&1 || true
		fi
	else
		rm -rf "$src_wp"
		git clone --depth 1 --branch "$tag" https://github.com/WordPress/WordPress.git "$src_wp" >/dev/null 2>&1
	fi
	mkdir -p "$cache_dir/WordPress" "$cache_dir/tests-WordPress"
	stop_spinner
	# Skip the copy only when the destination already has the core files we need
	# (a prior rsync succeeded) — otherwise a re-pull that skipped rsync would
	# leave tests-WordPress/ empty and break the test run. WP_ENV_SKIP_RSYNC=1
	# is an explicit force-skip for callers that have already verified the copy.
	if [ -z "$WP_ENV_SKIP_RSYNC" ] || [ ! -f "$cache_dir/tests-WordPress/wp-settings.php" ]; then
		start_spinner "copying WordPress core into cache…"
		rsync -a --delete --exclude=.git "$src_wp/" "$cache_dir/WordPress/"
		rsync -a --delete --exclude=.git "$src_wp/" "$cache_dir/tests-WordPress/"
		stop_spinner
	fi

	# --- WordPress/wordpress-develop (test framework) -> *-PHPUnit/tests/phpunit/ ---
	start_spinner "cloning wordpress-develop ($tag)…"
	if [ -d "$src_dev/.git" ]; then
		local at_dev="$tag"
		[ "$tag" != "trunk" ] && at_dev="$(git -C "$src_dev" rev-parse "$tag" 2>/dev/null || true)"
		local cur_dev="$(git -C "$src_dev" rev-parse HEAD 2>/dev/null || true)"
		if [ -n "$at_dev" ] && [ "$at_dev" = "$cur_dev" ]; then
			git -C "$src_dev" checkout -q "$tag" >/dev/null 2>&1 || true
		elif [ "$tag" = "trunk" ]; then
			git -C "$src_dev" fetch --tags >/dev/null 2>&1 || true
			git -C "$src_dev" pull --ff-only >/dev/null 2>&1 || true
		else
			git -C "$src_dev" fetch --tags >/dev/null 2>&1 || true
			git -C "$src_dev" checkout "$tag" >/dev/null 2>&1 || true
		fi
	else
		rm -rf "$src_dev"
		git clone --depth 1 --branch "$tag" https://github.com/WordPress/wordpress-develop.git "$src_dev" >/dev/null 2>&1
	fi
	stop_spinner
	start_spinner "arranging PHPUnit libs + wp-tests-config.php…"
	for dst in "$cache_dir/WordPress-PHPUnit" "$cache_dir/tests-WordPress-PHPUnit"; do
		mkdir -p "$dst/tests/phpunit/includes"
		rsync -a --delete "$src_dev/tests/phpunit/includes/" "$dst/tests/phpunit/includes/"
		cp "$src_dev/wp-tests-config-sample.php" "$dst/tests/phpunit/wp-tests-config.php" 2>/dev/null || true
		# Rewrite the test config the same way install-wp-tests.sh does.
		sed -i '' "s:dirname( __FILE__ ) . '/src/':'$cache_dir/tests-WordPress/':" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s/youremptytestdbnamehere/tests-wordpress/" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s/yourusernamehere/root/" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s/yourpasswordhere/password/" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s|localhost|tests-mysql|" "$dst/tests/phpunit/wp-tests-config.php"
	done
	stop_spinner
}

# Seed the cache from git (replaces the wp-env dependency).
install_wp_tests() {
	local ver="${1:-latest}"
	local tag
	tag="$(resolve_wp_version "$ver")" || return 1

	# Pick the cache dir.
	local cache_dir=""
	if [ -n "$WP_ENV_CACHE_DIR" ] && [ -d "$WP_ENV_CACHE_DIR" ]; then
		cache_dir="$WP_ENV_CACHE_DIR"
	elif [ "$(list_cache_dirs | grep -c . || true)" = "1" ]; then
		cache_dir="$(list_cache_dirs)"
	else
		cache_dir="$HOME/.wp-env/wp-env-opossum-$tag"
	fi
	mkdir -p "$cache_dir"

	# If the clone already exists, re-pull in place instead of re-cloning.
	if [ -d "$cache_dir/.src-wordpress/.git" ]; then
		echo "mac-env: cache already seeded at $cache_dir — re-pulling (use 'mac-env fetch' next time)…"
		# Skip the tree rsync so a re-pull of an unchanged pinned version is
		# near-instant; `fetch` does the full rsync when a real refresh is wanted.
		WP_ENV_SKIP_RSYNC=1 fetch_wp_env_cache "$cache_dir"
		return $?
	fi

	sync_wp_env_cache "$cache_dir" "$tag"
	printf '%s' "$tag" > "$cache_dir/.wp-env-version"

	echo "mac-env: cache ready at $cache_dir"
	echo "  version     : $tag"
	echo "  next step   : set WP_ENV_CACHE_DIR in .env (or run 'mac-env init' to auto-fill), then 'mac-env up'"
}

# Re-pull the pinned version in place (the git-fetch equivalent).
# Optional $1: explicit cache dir (used when install-wp-tests re-pulls an
# existing clone). Falls back to WP_ENV_CACHE_DIR / detect_cache_dir.
fetch_wp_env_cache() {
	local cache_dir="${1:-}"
	if [ -z "$cache_dir" ] && [ -n "$WP_ENV_CACHE_DIR" ] && [ -d "$WP_ENV_CACHE_DIR" ]; then
		cache_dir="$WP_ENV_CACHE_DIR"
	elif [ -z "$cache_dir" ]; then
		cache_dir="$(detect_cache_dir || true)"
	fi
	if [ -z "$cache_dir" ] || [ ! -d "$cache_dir" ]; then
		echo "mac-env: no cache dir found — run 'mac-env install-wp-tests [version]' first." >&2
		return 1
	fi
	local tag="$(cat "$cache_dir/.wp-env-version" 2>/dev/null || true)"
	if [ -z "$tag" ]; then
		# Fall back to the current checkout of the wordpress clone, if present.
		tag="$(git -C "$cache_dir/.src-wordpress" describe --tags 2>/dev/null || true)"
		if [ -z "$tag" ]; then
			echo "mac-env: no pinned version in $cache_dir/.wp-env-version — run 'mac-env install-wp-tests [version]'." >&2
			return 1
		fi
	fi

	echo "mac-env: fetching WordPress ($tag) in $cache_dir …"
	sync_wp_env_cache "$cache_dir" "$tag"
	echo "mac-env: fetched $tag"
}

# List available cache dirs with their pinned version.
list_cache_dirs_verbose() {
	if [ ! -d "$HOME/.wp-env" ]; then
		echo "(no ~/.wp-env cache found)"
		return 0
	fi
	local found=0
	for d in $(list_cache_dirs); do
		found=1
		local ver="$(cat "$d/.wp-env-version" 2>/dev/null || true)"
		local marker="(unknown)"
		if [ -n "$ver" ]; then
			marker="(git)"
		elif [ -f "$d/WordPress/wp-settings.php" ]; then
			ver="—"; marker="(wp-env)"
		fi
		printf '%-55s %-10s %s\n' "$d" "${ver:-—}" "$marker"
	done
	[ "$found" = "0" ] && echo "(no ~/.wp-env cache dirs found)"
}

# Print the full command list (canonical — shown by `mac-env help`).
print_help() {
	cat <<'EOF'
mac-env — wp-env replacement backed by Apple `container` via opossum

Usage:
  mac-env init              scaffold compose.yaml + .env + docker/; add scripts; gitignore
  mac-env up                build + start + provision (install WordPress)
  mac-env down              stop + remove (pass -v to also drop volumes)
  mac-env provision         re-run just the WordPress install/activation step
  mac-env test             run the PHPUnit suite in tests-cli
  mac-env test:multisite / test:coverage / test:php80
  mac-env install-wp-tests [wp-version]   seed ~/.wp-env cache from git (X.Y.Z | trunk | latest)
  mac-env fetch            re-pull the pinned WordPress version (git fetch in place)
  mac-env cache-list       list ~/.wp-env/* cache dirs with their pinned version
  mac-env help | --help   show this help

Any other argument is forwarded to `opossum -f compose.yaml`
(ps | logs | exec | run | config | ...).

First run: `mac-env install-wp-tests`, then `mac-env init`, then `mac-env up`.
EOF
}

# WordPress test bootstrap needs wp-tests-config.php in the core root.
generate_wp_tests_config() {
	if [ -n "$WP_ENV_CACHE_DIR" ]; then
		# Rewrite only the port, whatever the DB host (localhost or tests-mysql).
		sed -i '' -E "s#:[0-9]+\b#:${TESTS_PORT}#g" \
			"$WP_ENV_CACHE_DIR/tests-WordPress-PHPUnit/tests/phpunit/wp-tests-config.php" 2>/dev/null || true
	fi
	for svc in wordpress tests-wordpress; do
		if "$OPOSSUM" exec "$svc" cp /wordpress-phpunit/wp-tests-config.php /var/www/html/wp-tests-config.php 2>/dev/null; then
			"$OPOSSUM" exec "$svc" sh -c "sed -i -E 's#:[0-9]+\\b#:${TESTS_PORT}#g' /var/www/html/wp-tests-config.php" >/dev/null 2>&1 || true
		else
			echo "mac-env: $svc: /wordpress-phpunit/wp-tests-config.php not found — run 'mac-env install-wp-tests' or 'wp-env start' once to populate the cache." >&2
		fi
	done
}

# Install WordPress (dev + tests), apply config, activate. Idempotent.
provision() {
	local plugins=""
	themes=""
	if [ -f .wp-env.json ]; then
		plugins="$(python3 -c "import json; d=json.load(open('.wp-env.json')); print(' '.join([p.rstrip('/').split('/')[-1] for p in d.get('plugins',[])]))" 2>/dev/null)"
		themes="$(python3 -c "import json; d=json.load(open('.wp-env.json')); print(' '.join([t.rstrip('/').split('/')[-1] for t in d.get('themes',[])]))" 2>/dev/null)"
	fi

	# --- Development site ---
	if ! "$OPOSSUM" exec cli wp core is-installed >/dev/null 2>&1; then
		"$OPOSSUM" exec cli wp core install \
			--url="http://localhost:${DEV_PORT}" \
			--title="$PROJECT_NAME" \
			--admin_user=admin --admin_password=password \
			--admin_email=wordpress@example.com --skip-email >/dev/null 2>&1
	fi
	if [ -f .wp-env.json ]; then
		python3 -c "
import json
d=json.load(open('.wp-env.json'))
for env in d.get('env',{}).values():
	for k,v in (env.get('config') or {}).items():
		if v is None: continue
		val = '\"%s\"' % v if isinstance(v,str) else v
		print('wp config set %s %s%s' % (k, val, ' --raw' if not isinstance(v,str) else ''))
" 2>/dev/null | while read -r line; do
			"$OPOSSUM" exec cli wp $line >/dev/null 2>&1 || true
		done
	fi
	# Activate on the DEV site only; the test install is bootstrapped fresh.
	[ -n "$plugins" ] && "$OPOSSUM" exec cli wp plugin activate $plugins >/dev/null 2>&1 || true
	[ -n "$themes" ] && "$OPOSSUM" exec cli wp theme activate $themes >/dev/null 2>&1 || true
	"$OPOSSUM" exec cli wp theme activate "$DEV_THEME" >/dev/null 2>&1 || true
	# Keep the site URL in sync with the current port (wp-env bakes it into
	# wp-config.php constants that override the DB).
	"$OPOSSUM" exec wordpress sh -c "sed -i 's#http://localhost:[0-9]*#http://localhost:${DEV_PORT}#g' /var/www/html/wp-config.php" >/dev/null 2>&1 || true
	[ -n "$WP_ENV_CACHE_DIR" ] && sed -i '' "s#http://localhost:[0-9]*#http://localhost:${DEV_PORT}#g" "$WP_ENV_CACHE_DIR/WordPress/wp-config.php" 2>/dev/null || true
	"$OPOSSUM" exec cli wp option update home "http://localhost:${DEV_PORT}" >/dev/null 2>&1 || true
	"$OPOSSUM" exec cli wp option update siteurl "http://localhost:${DEV_PORT}" >/dev/null 2>&1 || true

	# --- Tests site ---
	if ! "$OPOSSUM" exec tests-cli wp core is-installed >/dev/null 2>&1; then
		"$OPOSSUM" exec tests-cli wp core install \
			--url="http://localhost:${TESTS_PORT}" \
			--title="$PROJECT_NAME" \
			--admin_user=admin --admin_password=password \
			--admin_email=wordpress@example.com --skip-email >/dev/null 2>&1
	fi

	generate_wp_tests_config
}

run_tests() {
	case "$1" in
		multisite) export WP_MULTISITE=1; coverage_flags="" ;;
		coverage) export WP_MULTISITE=0; coverage_flags="--coverage-text --colors=never" ;;
		php80) export WP_MULTISITE=0; coverage_flags="" ;;
		*) export WP_MULTISITE=0; coverage_flags="" ;;
	esac
	"$OPOSSUM" exec tests-cli env \
	WP_TESTS_PHPUNIT_POLYFILLS_PATH=/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/vendor/yoast/phpunit-polyfills \
	/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/vendor/bin/phpunit \
	--config=/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/phpunit.xml \
	$coverage_flags
}

case "$1" in
	help|--help|"") print_help ;;
	init) do_init ;;
	up)
		# Apple `container`/opossum won't auto-create bind-mount sources, so
		# ensure the container home dirs exist (pure runtime scratch space;
		# gitignored, regenerated empty on clone).
		mkdir -p .opossum-home/user .opossum-home/tests-user
		ensure_dns
		"$OPOSSUM" -f "$COMPOSE" up "${@:2}"
		provision
		;;
	down)
		"$OPOSSUM" -f "$COMPOSE" down "${@:2}"
		;;
	provision) provision ;;
	install-wp-tests) install_wp_tests "${2:-latest}" ;;
	fetch) fetch_wp_env_cache ;;
	cache-list) list_cache_dirs_verbose ;;
	test) run_tests "${2:-default}" ;;
	test:multisite) run_tests multisite ;;
	test:coverage) run_tests coverage ;;
	test:php80) run_tests php80 ;;
	*)
		"$OPOSSUM" -f "$COMPOSE" "$@"
		;;
esac
